<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Unique Character Base __________-->

    <PawnKindDef Name="FCP_MarkedMen_UniqueCharacterBase" ParentName="FCP_MarkedManKindBase" Abstract="True">
        <showInDebugSpawner>false</showInDebugSpawner>
        <apparelMoney>9999</apparelMoney>
        <gearHealthRange>0.6~1.0</gearHealthRange>
        <apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
        <apparelIgnoreSeasons>true</apparelIgnoreSeasons>
        <weaponMoney>9999</weaponMoney>
        <initialWillRange>10~30</initialWillRange>
        <initialResistanceRange>10~30</initialResistanceRange>
    </PawnKindDef>

    <!-- Blister -->

    <PawnKindDef ParentName="FCP_MarkedMen_UniqueCharacterBase">
        <defName>FCP_Unique_Pawnkind_MarkedMen_Blister</defName>
        <label>Blister</label>
        <combatPower>140</combatPower>
        <apparelRequired>
            <li>FCP_Apparel_Marked_Patrol_Armor</li>
            <li>FCP_Apparel_NCR_Veteran_Ranger_Helmet</li>
        </apparelRequired>
        <weaponTags>
            <li MayRequire="Rick.FCP.EnergyWeapons">FCP_Flame_Weapon</li>
        </weaponTags>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>FCP_Backstory_Wastelander_Child</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>FCP_Backstory_MarkedMan_HeavyGunner</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
    </PawnKindDef>

