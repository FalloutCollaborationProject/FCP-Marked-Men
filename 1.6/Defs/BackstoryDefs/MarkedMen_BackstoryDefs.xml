        <defName>FCP_Backstory_MarkedMan_Prisoner</defName>
        <identifier>FCP_Backstory_MarkedMan_Prisoner</identifier>
        <slot>Adulthood</slot>
        <title>Marked Prisoner</title>
        <titleShort>Marked Prisoner</titleShort>
        <description>Captured somewhere between the NCR line and the Legion's, [PAWN_nameDef] never learned which side held the cage. It didn't matter once the storm rolled in and both sides stopped being sides at all.</description>
        <skillGains>
            <Melee>6</Melee>
