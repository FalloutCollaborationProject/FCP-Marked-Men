        <defName>FCP_Backstory_MarkedMan_Berserker</defName>
        <identifier>FCP_Backstory_MarkedMan_Berserker</identifier>
        <slot>Adulthood</slot>
        <title>Marked Berserker</title>
        <titleShort>Marked Berserker</titleShort>
        <description>Whatever discipline [PAWN_nameDef] marched under Caesar with burned away with everything else the Divide took. What's left charges into the storm swinging, and hasn't stopped since.</description>
        <skillGains>
            <Melee>10</Melee>
