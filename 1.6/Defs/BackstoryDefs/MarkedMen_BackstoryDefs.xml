    <BackstoryDef>
        <defName>FCP_Backstory_MarkedMan_LongRifle</defName>
        <identifier>FCP_Backstory_MarkedMan_LongRifle</identifier>
        <slot>Adulthood</slot>
        <title>Marked Long Rifle</title>
        <titleShort>Marked Long Rifle</titleShort>
        <description>[PAWN_nameDef] spent the war watching the supply route through a scope, reporting movement no one above them heeded until it was too late. The habit of watching from a distance outlived the chain of command that trained it into them.</description>
        <skillGains>
            <Shooting>7</Shooting>
