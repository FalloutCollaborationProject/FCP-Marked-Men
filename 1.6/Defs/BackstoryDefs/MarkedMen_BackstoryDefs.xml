<Defs>

    <!--__________ Marked Men Backstories (Adulthood) __________-->

    <BackstoryDef>
        <defName>FCP_Backstory_MarkedMan_NCR_Trooper</defName>
        <identifier>FCP_Backstory_MarkedMan_NCR_Trooper</identifier>
        <slot>Adulthood</slot>
        <title>Marked Trooper</title>
        <titleShort>Marked Trooper</titleShort>
        <description>[PAWN_nameDef] wore NCR fatigues on the day the storm took the Divide apart. The uniform is rags now, and the chain of command it once answered to is a sound half-remembered, like a bugle call from underwater.</description>
        <skillGains>
            <Shooting>6</Shooting>
            <Melee>3</Melee>
        </skillGains>
        <workDisables>None</workDisables>
        <requiredWorkTags>None</requiredWorkTags>
        <spawnCategories>
            <li>FCP_Backstory_MarkedMan</li>
            <li>FCP_Backstory_MarkedMen_Hunter</li>
        </spawnCategories>
        <bodyTypeFemale>Female</bodyTypeFemale>
        <bodyTypeMale>Male</bodyTypeMale>
        <possessions />
    </BackstoryDef>

    <BackstoryDef>
        <defName>FCP_Backstory_MarkedMan_NCR_Ranger</defName>
        <identifier>FCP_Backstory_MarkedMan_NCR_Ranger</identifier>
        <slot>Adulthood</slot>
        <title>Marked Ranger</title>
        <titleShort>Marked Ranger</titleShort>
        <description>An NCR Ranger who went into the Divide on Ulysses' trail and never came out. What's left moves the way a Ranger moves, sights the way a Ranger sights, and remembers none of why.</description>
        <skillGains>
            <Shooting>8</Shooting>
            <Melee>4</Melee>
        </skillGains>
        <workDisables>None</workDisables>
        <requiredWorkTags>None</requiredWorkTags>
        <spawnCategories>
            <li>FCP_Backstory_MarkedMan</li>
            <li>FCP_Backstory_MarkedMen_Marauder</li>
        </spawnCategories>
        <bodyTypeFemale>Female</bodyTypeFemale>
        <bodyTypeMale>Male</bodyTypeMale>
        <possessions />
        <forcedTraits>
            <Tough>0</Tough>
        </forcedTraits>
    </BackstoryDef>

    <BackstoryDef>
        <defName>FCP_Backstory_MarkedMan_Legion_Recruit</defName>
        <identifier>FCP_Backstory_MarkedMan_Legion_Recruit</identifier>
        <slot>Adulthood</slot>
        <title>Marked Recruit</title>
        <titleShort>Marked Recruit</titleShort>
        <description>[PAWN_nameDef] marched under Caesar's banner into the Divide, one more body added to a war neither army walked away from. Legion discipline kept the body upright long after the storms burned the rest away.</description>
        <skillGains>
            <Melee>7</Melee>
            <Shooting>2</Shooting>
        </skillGains>
        <workDisables>None</workDisables>
        <requiredWorkTags>None</requiredWorkTags>
