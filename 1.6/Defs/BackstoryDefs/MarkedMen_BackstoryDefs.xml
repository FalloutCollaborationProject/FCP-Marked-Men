    <BackstoryDef>
        <defName>FCP_Backstory_MarkedMan_Legion_Veteran</defName>
        <identifier>FCP_Backstory_MarkedMan_Legion_Veteran</identifier>
        <slot>Adulthood</slot>
        <title>Marked Veteran</title>
        <titleShort>Marked Veteran</titleShort>
        <description>A Legion veteran of a dozen campaigns, undone by a war with no fronts and no enemy to break. The Divide gave [PAWN_nameDef] a new kind of endurance, and took everything else in trade.</description>
        <skillGains>
            <Melee>9</Melee>
            <Shooting>3</Shooting>
