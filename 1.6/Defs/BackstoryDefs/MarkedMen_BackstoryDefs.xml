        <defName>FCP_Backstory_MarkedMan_Executioner</defName>
        <identifier>FCP_Backstory_MarkedMan_Executioner</identifier>
        <slot>Adulthood</slot>
        <title>Marked Executioner</title>
        <titleShort>Marked Executioner</titleShort>
        <description>[PAWN_nameDef] carried out sentences for the Legion long before the Divide, and never really stopped. The blade changed hands a dozen times since, scavenged and re-scavenged, but the motion never left the arm.</description>
        <skillGains>
            <Melee>9</Melee>
