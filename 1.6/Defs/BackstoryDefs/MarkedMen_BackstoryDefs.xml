    <BackstoryDef>
        <defName>FCP_Backstory_MarkedMan_Courier</defName>
        <identifier>FCP_Backstory_MarkedMan_Courier</identifier>
        <slot>Adulthood</slot>
        <title>Marked Escort</title>
        <titleShort>Marked Escort</titleShort>
        <description>Hired muscle for a courier run through the Long 15 that ended in fire and static. [PAWN_nameDef] doesn't remember the cargo, or the client, or why the sky came apart. Only the running, and then the long stillness after.</description>
        <skillGains>
            <Shooting>5</Shooting>
            <Melee>5</Melee>
        </skillGains>
        <workDisables>None</workDisables>
