    <BackstoryDef>
        <defName>FCP_Backstory_MarkedMan_Runner</defName>
        <identifier>FCP_Backstory_MarkedMan_Runner</identifier>
        <slot>Adulthood</slot>
        <title>Marked Runner</title>
        <titleShort>Marked Runner</titleShort>
        <description>A scout who covered ground between NCR and Legion lines alike, trading information both sides paid well for. [PAWN_nameDef] still moves light and fast, carrying whatever mismatched gear came to hand instead of anything that marked them as one side or the other.</description>
        <skillGains>
