        <defName>FCP_Backstory_MarkedMan_Marksman</defName>
        <identifier>FCP_Backstory_MarkedMan_Marksman</identifier>
        <slot>Adulthood</slot>
        <title>Marked Marksman</title>
        <titleShort>Marked Marksman</titleShort>
        <description>A sharpshooter who held the line at the Divide's edge, picking off targets long before they closed the distance. [PAWN_nameDef] still sights down a rifle the way they were trained to, out of habit more than intent.</description>
        <skillGains>
            <Shooting>9</Shooting>
