        <identifier>FCP_Backstory_MarkedMan_Scavenger</identifier>
        <slot>Adulthood</slot>
        <title>Marked Quartermaster</title>
        <titleShort>Marked Quartermaster</titleShort>
        <description>Not a fighter, once. [PAWN_nameDef] kept the supply lines running for whichever army was paying that season, until the Divide erased the difference between quartermaster and casualty.</description>
        <skillGains>
            <Crafting>4</Crafting>
