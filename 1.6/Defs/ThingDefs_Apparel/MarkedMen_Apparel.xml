<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Marked Men Armor __________-->
    <!-- Battered remnants of NCR/Legion gear worn since the day the Divide burned. Faction-exclusive: never crafted by anyone else, never generated in general loot/trade. -->

    <!-- Marked Trooper Armor -->

    <ThingDef ParentName="FCP_Armor_Machineable_Base">
        <defName>FCP_Apparel_Marked_Trooper_Armor</defName>
        <label>marked trooper armor</label>
        <description>Ruined NCR trooper armor, worn by a soldier who never left the Divide. Patched over the years with roadsigns, license plates, and whatever scrap could be lashed to the plating. It still holds together, barely.</description>
        <thingSetMakerTags Inherit="False" />
        <recipeMaker IsNull="True" />
        <graphicData>
            <texPath>Armor/Marked_Trooper_Armor/FCP_Marked_Trooper_Armor</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <statBases>
            <MaxHitPoints>160</MaxHitPoints>
            <WorkToMake>8700</WorkToMake>
            <Mass>4.2</Mass>
            <ArmorRating_Sharp>0.62</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.28</ArmorRating_Blunt>
            <ArmorRating_Heat>0.23</ArmorRating_Heat>
            <Insulation_Cold>7</Insulation_Cold>
            <Insulation_Heat>5</Insulation_Heat>
            <EquipDelay>1.2</EquipDelay>
        </statBases>
        <costList>
            <Steel>30</Steel>
        </costList>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Legs</li>
                <li>Shoulders</li>
                <li>Arms</li>
            </bodyPartGroups>
            <wornGraphicPath>Armor/Marked_Trooper_Armor/FCP_Marked_Trooper_Armor</wornGraphicPath>
            <layers>
                <li>OnSkin</li>
                <li>Middle</li>
            </layers>
            <tags>
                <li>FCP_MarkedMen_Apparel</li>
            </tags>
        </apparel>
        <comps>
            <li Class="FCP.Core.CompProperties_LabelColored">
                <rarity>Rare</rarity>
            </li>
        </comps>
    </ThingDef>

    <!-- Marked Patrol Armor -->

    <ThingDef ParentName="FCP_Armor_Machineable_Base">
        <defName>FCP_Apparel_Marked_Patrol_Armor</defName>
        <label>marked patrol armor</label>
        <description>Ranger patrol armor scavenged from the Divide's dead. The wear tells the story on its own: scorched plating, sun-bleached straps, and the ghost of an NCR bear stencil still visible under the grime.</description>
        <thingSetMakerTags Inherit="False" />
        <recipeMaker IsNull="True" />
        <graphicData>
            <texPath>Armor/Marked_Patrol_Armor/FCP_Marked_Patrol_Armor</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <statBases>
            <MaxHitPoints>185</MaxHitPoints>
            <WorkToMake>9200</WorkToMake>
            <Mass>5.2</Mass>
            <ArmorRating_Sharp>0.75</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.33</ArmorRating_Blunt>
            <ArmorRating_Heat>0.26</ArmorRating_Heat>
            <Insulation_Cold>8</Insulation_Cold>
            <Insulation_Heat>6</Insulation_Heat>
            <EquipDelay>1.2</EquipDelay>
        </statBases>
        <costList>
            <Steel>40</Steel>
        </costList>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
