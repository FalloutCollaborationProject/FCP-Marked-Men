    <!-- Marked Tribal Helmet -->

    <ThingDef ParentName="FCP_Armor_Helmet_Makeable_Base">
        <defName>FCP_Apparel_Marked_Tribal_Helmet</defName>
        <label>marked tribal helmet</label>
        <description>A crude helmet built from scrap and hide, the closest thing to a legate's helm that could be scavenged from the Divide's ruin. Whatever it was salvaged from is long past recognizing.</description>
        <thingSetMakerTags Inherit="False" />
        <graphicData>
            <texPath>Armor/Marked_Tribal_Helmet/FCP_Marked_Tribal_Helmet</texPath>
