    <!-- Marked Tribal Armor -->

    <ThingDef ParentName="FCP_Armor_Machineable_Base">
        <defName>FCP_Apparel_Marked_Tribal_Armor</defName>
        <label>marked tribal armor</label>
        <description>Not NCR, not Legion — this armor was built from nothing but the Divide itself. Layered hide, roadsign scrap, and rebar plating lashed together by hands that no longer remember which army they used to answer to. There is no clean version of this armor to reclaim; it was never anything but wreckage.</description>
        <thingSetMakerTags Inherit="False" />
        <graphicData>
            <texPath>Armor/Marked_Tribal_Armor/FCP_Marked_Tribal_Armor</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <statBases>
            <MaxHitPoints>175</MaxHitPoints>
            <WorkToMake>9200</WorkToMake>
            <Mass>4.8</Mass>
            <ArmorRating_Sharp>0.68</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.35</ArmorRating_Blunt>
