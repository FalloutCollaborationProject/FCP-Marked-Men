    </ThingDef>

    <!-- Marked Scout Armor -->

    <ThingDef ParentName="FCP_Armor_Machineable_Base">
        <defName>FCP_Apparel_Marked_Scout_Armor</defName>
        <label>marked scout armor</label>
        <description>Legion armor cobbled back together after the Divide tore it apart. Nails and scrap metal have been driven into the leather in rough imitation of a legate's regalia, an old habit from soldiers who no longer remember why they kept it up.</description>
        <thingSetMakerTags Inherit="False" />
        <recipeMaker IsNull="True" />
        <graphicData>
